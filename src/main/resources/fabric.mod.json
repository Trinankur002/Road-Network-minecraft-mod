{
	"schemaVersion": 1,
	"id": "road-network",
	"version": "${version}",
	"name": "Road Network",
	"description": "Autonomous, civil-engineered road networks connecting villages and major structures with terrain-conforming paths, arched river bridges, Roman barrel vault mountain tunnels, and biome-adaptive aesthetics.",
	"authors": [
		"Trinankur"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/road-network/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.trinankur.roadnetwork.RoadNetwork"
		],
		"client": [
			"com.trinankur.roadnetwork.client.RoadNetworkClient"
		]
	},
	"mixins": [
		"road-network.mixins.json",
		{
			"config": "road-network.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}